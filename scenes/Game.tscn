[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/Game.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/Player.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/HUD.tscn" id="3"]
[ext_resource type="PackedScene" path="res://scenes/ShopPanel.tscn" id="4"]

[node name="Game" type="Node2D"]
script = ExtResource("1")

[node name="Player" parent="." instance=ExtResource("2")]
position = Vector2(640, 360)

[node name="SpawnTimer" type="Timer" parent="."]
wait_time = 1.2
autostart = false

[node name="WaveTimer" type="Timer" parent="."]
wait_time = 30.0
autostart = false

[node name="CanvasLayer" type="CanvasLayer" parent="."]


[node name="ArenaColor" type="ColorRect" parent="CanvasLayer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.08, 0.1, 0.13, 0.35)

[node name="HUD" parent="CanvasLayer" instance=ExtResource("3")]

[node name="ShopPanel" parent="CanvasLayer" instance=ExtResource("4")]

[node name="PauseMenu" type="PanelContainer" parent="CanvasLayer"]
visible = false
offset_left = 500.0
offset_top = 220.0
offset_right = 780.0
offset_bottom = 480.0

[node name="VBox" type="VBoxContainer" parent="CanvasLayer/PauseMenu"]
layout_mode = 2

[node name="Resume" type="Button" parent="CanvasLayer/PauseMenu/VBox"]
layout_mode = 2
text = "Wznów"

[node name="Menu" type="Button" parent="CanvasLayer/PauseMenu/VBox"]
layout_mode = 2
text = "Menu główne"

[connection signal="timeout" from="SpawnTimer" to="." method="_on_spawn_timer_timeout"]
[connection signal="timeout" from="WaveTimer" to="." method="_on_wave_timer_timeout"]
[connection signal="closed" from="CanvasLayer/ShopPanel" to="." method="_on_shop_closed"]
[connection signal="pressed" from="CanvasLayer/PauseMenu/VBox/Resume" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="CanvasLayer/PauseMenu/VBox/Menu" to="." method="_on_menu_pressed"]
